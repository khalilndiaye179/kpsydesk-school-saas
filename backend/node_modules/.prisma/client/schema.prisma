datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --- Modèles Globaux (Sans RLS) ---

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  subdomain String       @unique
  status    TenantStatus @default(TRIAL)
  plan      SaaSPlan     @default(TRIAL_7D)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Relations
  users      TenantUser[]
  modules    TenantModule[]
  classes    Class[]
  students   Student[]
  teachers   Teacher[]
  courses    Course[]
  timetables Timetable[]
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum SaaSPlan {
  TRIAL_7D
  STANDARD
  PREMIUM
  ENTERPRISE
}

model PlatformUser {
  id                 String       @id @default(uuid()) @db.Uuid
  email              String       @unique
  passwordHash       String
  role               PlatformRole @default(SUPPORT)
  isTwoFactorEnabled Boolean      @default(false)
  twoFactorSecret    String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT
  COMMERCIAL
  TECH_OPS
}

model TenantModule {
  tenantId  String   @db.Uuid
  moduleKey String
  enabled   Boolean  @default(false)
  updatedBy String?
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, moduleKey])
}

// --- Modèles Tenant-Scoped (Avec RLS) ---

model TenantUser {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @db.Uuid
  email        String
  passwordHash String
  role         TenantRole @default(TEACHER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
}

enum TenantRole {
  DIRECTOR
  CENSOR
  TEACHER
  ACCOUNTANT
  PARENT
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// Modèles spécifiques de la Phase 2

model Class {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  code      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  students   Student[]
  timetables Timetable[]

  @@unique([tenantId, code])
}

model Student {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  classId   String   @db.Uuid
  firstName String
  lastName  String
  email     String?
  birthDate DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class  Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
}

model Teacher {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  firstName String
  lastName  String
  email     String
  specialty String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timetables Timetable[]

  @@unique([tenantId, email])
}

model Course {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  code        String
  coefficient Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  timetables Timetable[]

  @@unique([tenantId, code])
}

model Timetable {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  classId   String   @db.Uuid
  teacherId String   @db.Uuid
  courseId  String   @db.Uuid
  dayOfWeek Int // 1 (Lundi) à 6 (Samedi)
  startTime String // ex. "08:00"
  endTime   String // ex. "10:00"
  room      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String    @id @default(uuid()) @db.Uuid
  actorType ActorType
  actorId   String    @db.Uuid
  tenantId  String?   @db.Uuid
  action    String
  target    String
  metadata  Json?
  createdAt DateTime  @default(now())
}

enum ActorType {
  TENANT_USER
  PLATFORM_USER
}
