# ------------------------------------------------------------------------------
# ENVIRONMENT VARIABLES - KPSYDESK SCHOOL BACKEND (TEMPLATE GENERIQUE)
# ------------------------------------------------------------------------------

# Database (PostgreSQL Connection String)
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?schema=public"

# Auth / Security (OBLIGATOIRES - Generer des cles aleatoires de 32+ caracteres)
JWT_SECRET="<METTRE_ICI_UNE_CLE_SECRETE_JWT_LONGUE_ET_ALEATOIRE>"
JWT_EXPIRES_IN="7d"
MFA_ENCRYPTION_KEY="<METTRE_ICI_UNE_CLE_AES_256_32_BYTES_HEX_ALEATOIRE>"

# Credentials d'initialisation du premier SuperAdmin (Seed)
INITIAL_SUPERADMIN_EMAIL="admin@votre-domaine.com"
INITIAL_SUPERADMIN_PASSWORD="<COMPLEX_INITIAL_SUPERADMIN_PASSWORD>"

# Configuration SMTP (Envoi des emails & OTP)
SMTP_HOST="smtp.votre-serveur-mail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="votre-compte-smtp@votre-domaine.com"
SMTP_PASS="<VOTRE_MOT_DE_PASSE_SMTP_SECURISE>"
SMTP_FROM="KPSyDesk School <support@votre-domaine.com>"
