# ------------------------------------------------------------------------------
# ENVIRONMENT VARIABLES - KPSYDESK SCHOOL BACKEND
# Copiez ce fichier en `.env` (jamais versionné) et remplacez chaque valeur.
# ------------------------------------------------------------------------------

# Database
DATABASE_URL="postgresql://<db_user>:<db_password>@postgres:5432/<db_name>?schema=public"

# Auth / JWT — obligatoire, minimum 32 caractères aléatoires.
# Génération : openssl rand -base64 48
JWT_SECRET="<générer_un_secret_aléatoire>"
JWT_EXPIRES_IN="7d"

# Origines autorisées pour le CORS (séparées par des virgules).
# Vide = aucune origine cross-origin autorisée.
CORS_ORIGINS="https://school.kpsyinformatique.com"

PORT=3000

# ------------------------------------------------------------------------------
# CONFIGURATION SMTP HOSTINGER (Port 465 - SSL/TLS Implicite)
# ------------------------------------------------------------------------------
# Note Technique : Pour le port 465 (Hostinger/OVH), SSL/TLS est implicite dès le départ.
# Utiliser SMTP_SECURE=true (secure: true dans Nodemailer).
# Pour le port 587 (Mailgun/Sendgrid), utiliser SMTP_SECURE=false (STARTTLS).
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="<smtp_user>"
SMTP_PASS="<smtp_password>"
SMTP_FROM="KPSyDesk School <no-reply@example.com>"

# Compte SuperAdmin initial utilisé uniquement par `npm run seed`
INITIAL_SUPERADMIN_EMAIL="<admin@example.com>"
INITIAL_SUPERADMIN_PASSWORD="<mot_de_passe_fort_unique>"
