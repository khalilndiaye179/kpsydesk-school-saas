# ------------------------------------------------------------------------------
# CONFIGURATION SMTP HOSTINGER (Port 465 - SSL/TLS Implicite)
# ------------------------------------------------------------------------------
# Note Technique : Pour le port 465 (Hostinger/OVH), SSL/TLS est implicite dès le départ.
# Utiliser SMTP_SECURE=true (secure: true dans Nodemailer).
# Pour le port 587 (Mailgun/Sendgrid), utiliser SMTP_SECURE=false (STARTTLS).
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="kpsydesk.support@kpsyinformatique.com"
SMTP_PASS="votre_mot_de_passe_hostinger_securise"
SMTP_FROM="KPSyDesk School <kpsydesk.support@kpsyinformatique.com>"
